{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$code.length == 5",

        "createdAt": { ".validate": "newData.isNumber()" },
        "seed":      { ".validate": "newData.isString() && newData.val().length <= 16" },

        "meta": {
          "hostId": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "state":  { ".validate": "newData.val() == 'LOBBY' || newData.val() == 'PREP' || newData.val() == 'LIVE' || newData.val() == 'FINAL_TWO' || newData.val() == 'END'" }
        },

        "config": {
          "diameterM":   { ".validate": "newData.isNumber() && newData.val() >= 200 && newData.val() <= 5000" },
          "durationMin": { ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 180" },
          "prepMinutes": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60" },
          "itemDensity": { ".validate": "newData.isNumber() && newData.val() >= 0.4 && newData.val() <= 2" }
        },

        "players": {
          "$pid": {
            "name":   { ".validate": "newData.isString() && newData.val().length <= 16" },
            "hp":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400" },
            "hunger": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
            "thirst": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
            "pos": {
              "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
              "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" }
            }
          }
        },

        "items":  { "$iid": { "lat": { ".validate": "newData.isNumber()" }, "lng": { ".validate": "newData.isNumber()" } } },
        "traps":  { "$tid": { "lat": { ".validate": "newData.isNumber()" }, "lng": { ".validate": "newData.isNumber()" } } },
        "fights": { "$fid": { "round": { ".validate": "newData.isNumber() && newData.val() <= 60" },
                              "distance": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" } } },
        "chase":  { "$fid": { "leftRadius": { ".validate": "newData.isBoolean()" } } },
        "sparks": { "pool": { ".validate": "newData.isNumber() && newData.val() >= 0" } },

        "feed": {
          "$k": {
            "atMs": { ".validate": "newData.isNumber()" },
            "type": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "text": { ".validate": "!newData.exists() || newData.val().length <= 300" }
          }
        }
      }
    },

    "faces": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$pid": { ".validate": "newData.isString() && newData.val().length < 200000" }
      }
    }
  }
}
